# CareerPilot AI Backend Environment Variables

# Application
APP_NAME=CareerPilot AI
APP_ENV=development
LOG_LEVEL=INFO

# Firebase Configuration
# Path to your Firebase service account JSON file, e.g., config/firebase-service-account.json
# If left blank, firebase-admin will attempt to initialize using Application Default Credentials (ADC)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=careerpilot-ai

# AI Configuration
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
